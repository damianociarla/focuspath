{
  "name": "focuspath",
  "version": "0.7.2",
  "description": "See where keyboard navigation breaks. A visual accessibility scanner for focus order.",
  "type": "module",
  "license": "MIT",
  "author": "Damiano Ciarla",
  "homepage": "https://github.com/damianociarla/focuspath#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damianociarla/focuspath.git"
  },
  "bugs": {
    "url": "https://github.com/damianociarla/focuspath/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "focus",
    "keyboard-navigation",
    "playwright",
    "testing"
  ],
  "bin": {
    "focuspath": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/reporter.ts src/report-limits.ts --format esm --dts --clean",
    "dev": "npm run build --silent && node dist/cli.js",
    "dev:check": "node scripts/check-dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:check": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict test-fixtures/documented-example.ts test-fixtures/reporter-example.ts",
    "prepublishOnly": "npm run build && npm run docs:check && npm test",
    "pack:check": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@julusian/jpeg-turbo": "3.0.1",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "jpeg-js": "0.4.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
