{
  "name": "focuspath-monorepo",
  "private": true,
  "version": "0.6.9",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace focuspath && npm run build --workspace @focuspath/api && npm run build --workspace @focuspath/web",
    "dev": "npm run dev --workspace @focuspath/web",
    "dev:api": "npm run dev --workspace @focuspath/api",
    "test": "npm test --workspaces --if-present && node --test scripts/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs:check": "npm run docs:check --workspace focuspath",
    "reporter:memory": "npm run build --workspace focuspath && node scripts/check-reporter-memory.mjs",
    "infra:check": "node scripts/check-infra.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "typescript-eslint": "8.67.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
